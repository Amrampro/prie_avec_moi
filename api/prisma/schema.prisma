generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  isAdmin      Boolean    @default(false)
  role         PrayerRole @default(MEMBRE)
  prayerPreferences Json?
  prayerRequests PrayerRequest[]
  prayerProgress PrayerProgress[]
  prayerAppointments PrayerAppointment[]
  prayerNotifications PrayerNotification[]
  contributionProofs ContributionProof[]
  testimonies PrayerTestimony[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  premiumStartAt DateTime?
  premiumEndAt DateTime?
  premiumCodes PremiumCode[]
  premiumActivations PremiumActivation[]

  favorites    Favorite[]
  posts        Post[]
  postLikes    PostLike[]
  postComments PostComment[]

  @@map("user")
}

enum PrayerRole {
  MEMBRE
  ACCOMPAGNATEUR
  ADMINISTRATEUR
}

enum PrayerRequestStatus {
  ENVOYEE
  EN_ETUDE
  PRECISION_DEMANDEE
  EN_PREPARATION
  DISPONIBLE
  TERMINEE
}

model PrayerRequest {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  text String @db.Text
  country String
  timezone String
  followUp String
  consentAt DateTime @default(now())
  status PrayerRequestStatus @default(ENVOYEE)
  companionId String?
  clarification String? @db.Text
  reply String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programs PrayerProgram[]
  appointments PrayerAppointment[]
  @@index([userId, createdAt])
  @@index([companionId, status])
  @@map("prayer_request")
}

model PrayerProgram {
  id String @id @default(cuid())
  title String
  description String? @db.Text
  kind String @default("PUBLIC")
  requestId String?
  request PrayerRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId String
  published Boolean @default(false)
  days Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress PrayerProgress[]
  @@index([kind, published])
  @@map("prayer_program")
}

model PrayerProgress {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program PrayerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  steps Json
  position String?
  positionAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([userId, programId])
  @@map("prayer_progress")
}

model PrayerSlot {
  id String @id @default(cuid())
  creatorId String
  startsAt DateTime
  duration Int
  timezone String
  contribution String?
  active Boolean @default(true)
  appointment PrayerAppointment?
  @@index([startsAt, active])
  @@map("prayer_slot")
}

model PrayerAppointment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String @unique
  request PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  slotId String @unique
  slot PrayerSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  timezone String
  companionId String?
  zoomUrl String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([companionId])
  @@map("prayer_appointment")
}

model ContributionMethod {
  id String @id @default(cuid())
  name String
  type String
  holder String
  account String
  bank String?
  iban String?
  swift String?
  currency String
  instructions String? @db.Text
  active Boolean @default(true)
  displayOrder Int @default(0)
  proofs ContributionProof[]
  @@map("contribution_method")
}

model ContributionProof {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  methodId String?
  method ContributionMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  amount Decimal? @db.Decimal(12, 2)
  currency String?
  reference String?
  filename String
  mime String
  status String @default("RECUE")
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("contribution_proof")
}

model PrayerNotification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  message String @db.Text
  resourceType String?
  resourceId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  dedupeKey String @unique
  emailSentAt DateTime?
  emailAttempts Int @default(0)
  @@index([userId, createdAt])
  @@map("prayer_notification")
}

model PrayerTestimony {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  text String @db.Text
  consent Boolean @default(false)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  @@map("prayer_testimony")
}

model Series {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  coverUrl    String?
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  meditations Meditation[]

  @@map("series")
}

model Meditation {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  imageUrl      String?
  isPremium     Boolean    @default(false)
  bodyText      String
  footerText    String?
  audioUrl      String?
  audioDuration String?
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  seriesId      String?
  series        Series?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  favorites     Favorite[]

  @@map("meditation")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  meditationId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meditation   Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)

  @@unique([userId, meditationId])
  @@map("favorite")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  place       String?
  address     String?
  imageUrl    String?
  theme       String?
  description String?
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([isPublished])
  @@map("event")
}

model Post {
  id          String      @id @default(cuid())
  text        String      @db.Text
  isPublished Boolean     @default(false)

  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  images      PostImage[]
  likes       PostLike[]
  comments    PostComment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
  @@index([authorId])
  @@map("post")
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("postimage")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("postlike")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
  @@map("postcomment")
}


enum PremiumCodeStatus {
  AVAILABLE
  USED
  EXPIRED
  DISABLED
}

enum PremiumDurationUnit {
  DAYS
  MONTHS
  YEARS
}

model PremiumCode {
  id String @id @default(cuid())
  code String @unique @db.VarChar(80)
  duration Int
  durationUnit PremiumDurationUnit @default(DAYS)
  status PremiumCodeStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  usedAt DateTime?
  expiresAt DateTime?
  usedById String?
  usedBy User? @relation(fields: [usedById], references: [id], onDelete: SetNull)
  activation PremiumActivation?

  @@index([status, createdAt])
  @@map("premium_code")
}

model PremiumActivation {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  premiumCodeId String @unique
  premiumCode PremiumCode @relation(fields: [premiumCodeId], references: [id], onDelete: Restrict)
  activatedAt DateTime @default(now())
  previousPremiumEndAt DateTime?
  newPremiumEndAt DateTime

  @@index([userId, activatedAt])
  @@map("premium_activation")
}
